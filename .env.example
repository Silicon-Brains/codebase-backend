PORT=4000
# Local development web origin. Add other local frontend origins only when needed.
CORS_ORIGIN=http://localhost:3000
# Keep unset during local development. Set only when running behind a trusted reverse proxy — enables
# `req.ip` (used by the /api/leads rate limiter) to read the real client IP from X-Forwarded-For.
# Value is passed straight to Express's `trust proxy` setting — e.g. "1" for a single proxy hop,
# or a specific proxy IP/CIDR. Leave unset for local dev. https://expressjs.com/en/guide/behind-proxies.html
TRUST_PROXY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Use the matching Clerk Development instance secret and webhook signing secret.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
